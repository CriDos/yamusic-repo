<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/fab_text_corners_radius" />
            <solid android:color="?buttonPrimaryDisabled" />
        </shape>
    </item>
    <item>
        <ripple android:color="?buttonPrimaryPressed">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/fab_text_corners_radius" />
                    <solid android:color="?buttonPrimary" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
