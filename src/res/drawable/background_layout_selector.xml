<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/background_item_pressed_ripple"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/mask" android:drawable="?selectableItemBackground" />
    <item>
        <selector>
            <item android:state_enabled="false" android:drawable="@color/transparent" />
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="?colorSecondary" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
