<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:drawable="?colorSecondaryBase" />
            <item android:drawable="?android:windowBackground" android:top="2.0dp" />
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:drawable="?colorSecondaryBase" />
            <item android:drawable="?android:windowBackground" android:top="2.0dp" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:drawable="?separatorColor" />
            <item android:drawable="?android:windowBackground" android:top="1.0dp" />
            <item android:drawable="?selectableItemBackground" android:top="1.0dp" />
        </layer-list>
    </item>
</selector>
