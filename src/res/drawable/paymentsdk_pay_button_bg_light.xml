<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="?colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_enabled="true">
                <shape android:shape="rectangle">
                    <corners android:radius="16.0dp" />
                    <gradient android:startColor="#ff3333" android:endColor="#ff8709" android:angle="270.0" android:centerColor="#ff731d" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16.0dp" />
                    <solid android:color="#0d000000" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
