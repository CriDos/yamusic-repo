<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme.Dark"
    android:background="?attr/bgPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.music.ui.view.CropImageView
        android:id="@+id/promo_cover_blurred"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionName="shared_cover_blurred"
        app:cropAlign="top"
        app:cropType="fit_fill"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/AppDesign.Dark"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/close_content_description"
        app:navigationIcon="@drawable/ic_close_mid_24">
        <Button
            android:layout_gravity="center"
            android:id="@+id/upload_cover"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playlist_upload_cover_button_text"
            style="@style/ButtonStyle.Small.White"/>
    </androidx.appcompat.widget.Toolbar>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="55dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/promo_cover"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:transitionName="shared_cover"/>
            <FrameLayout
                android:id="@+id/upload_cover_progress"
                android:background="?attr/bgFade"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </FrameLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/VerticalScrollBar">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="@dimen/edge_margin"
                android:paddingRight="@dimen/edge_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/textSecondary"
                    android:id="@+id/copyright_info"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Medium_14_16"/>
                <TextView
                    android:textColor="?attr/textPrimary"
                    android:id="@+id/promo_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Bold_HL_28_28"/>
                <TextView
                    android:textColor="?attr/textPrimary"
                    android:id="@+id/promo_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    style="@style/Medium_14_16"/>
                <TextView
                    android:textColor="?attr/textSecondary"
                    android:id="@+id/promo_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edge_margin"
                    style="@style/Medium_14_16"/>
                <TextView
                    android:textColor="?attr/textPrimary"
                    android:id="@+id/promo_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edge_margin"
                    android:layout_marginBottom="@dimen/edge_margin"
                    style="@style/Medium_14_16"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
