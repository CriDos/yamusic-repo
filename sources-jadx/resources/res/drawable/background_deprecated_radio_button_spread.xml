<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/radio_button_1_pressed_ripple">
    <item
        android:id="@android:id/mask"
        android:drawable="@drawable/radio_button_1_mask"/>
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorSecondaryVariant"/>
                    <corners
                        android:topLeftRadius="@dimen/radio_button_1_corner_radius"
                        android:topRightRadius="@dimen/radio_button_1_corner_radius"
                        android:bottomLeftRadius="@dimen/radio_button_1_corner_radius"
                        android:bottomRightRadius="@dimen/radio_button_1_corner_radius"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorSecondary"/>
                    <corners
                        android:topLeftRadius="@dimen/radio_button_1_corner_radius"
                        android:topRightRadius="@dimen/radio_button_1_corner_radius"
                        android:bottomLeftRadius="@dimen/radio_button_1_corner_radius"
                        android:bottomRightRadius="@dimen/radio_button_1_corner_radius"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
