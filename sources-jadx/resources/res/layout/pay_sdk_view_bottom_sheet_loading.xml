<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/pay_sdk_shadow"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/loading_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pay_sdk_bottom_sheet_height"
        app:shapeAppearance="@style/PaySdk.Shape.BottomSheet">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="@drawable/pay_sdk_glyph"
                android:layout_width="34dp"
                android:layout_height="5dp"
                android:layout_marginTop="@dimen/pay_sdk_margin_middle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.helper.widget.Flow
                android:orientation="vertical"
                android:id="@+id/loading_texts_flow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/pay_sdk_margin_large"
                android:layout_marginRight="@dimen/pay_sdk_margin_large"
                android:layout_marginHorizontal="@dimen/pay_sdk_margin_large"
                app:constraint_referenced_ids="loading_progress_view, loading_title, loading_text"
                app:flow_horizontalAlign="center"
                app:flow_verticalGap="@dimen/pay_sdk_margin_middle"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yandex.plus.pay.ui.common.api.ui.view.ProgressView
                android:id="@+id/loading_progress_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textAppearance="@style/PaySDK.TextAppearance.Title4"
                android:gravity="center"
                android:id="@+id/loading_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                app:layout_constrainedWidth="true"/>
            <TextView
                android:textAppearance="@style/PaySDK.TextAppearance.Body2"
                android:textColor="?attr/pay_sdk_primaryTextColor"
                android:gravity="center"
                android:id="@+id/loading_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                app:layout_constrainedWidth="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
