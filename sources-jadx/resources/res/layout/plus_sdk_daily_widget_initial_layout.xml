<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/plus_sdk_daily_widget_round_corners_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/plus_sdk_daily_widget_initial_layout_background">
    <ImageView
        android:id="@+id/plus_sdk_daily_widget_initial_vertical_center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:contentDescription="@null"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/plus_sdk_daily_widget_music_icon"
        android:tint="@color/plus_sdk_daily_widget_initial_layout_music_icon"
        android:layout_alignParentTop="true"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/plus_sdk_daily_widget_initial_top_stub"
        android:background="@drawable/plus_sdk_daily_widget_circle_background"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:layout_alignParentTop="true"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"
        android:backgroundTint="@color/plus_sdk_daily_widget_initial_layout_accent"/>
    <ImageView
        android:id="@+id/plus_sdk_daily_widget_initial_middle_stub"
        android:background="@drawable/plus_sdk_daily_widget_small_round_corners_background"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="17dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/plus_sdk_daily_widget_initial_top_stub"
        android:contentDescription="@null"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:backgroundTint="@color/plus_sdk_daily_widget_initial_layout_accent"
        android:layout_marginHorizontal="16dp"/>
    <ImageView
        android:background="@drawable/plus_sdk_daily_widget_small_round_corners_background"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/plus_sdk_daily_widget_initial_middle_stub"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"
        android:layout_toStartOf="@+id/plus_sdk_daily_widget_initial_vertical_center"
        android:layout_alignParentStart="true"
        android:backgroundTint="@color/plus_sdk_daily_widget_initial_layout_accent"/>
</RelativeLayout>
