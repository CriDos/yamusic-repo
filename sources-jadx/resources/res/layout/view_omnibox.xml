<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/search_image_view"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_search_small_2"
            android:scaleType="centerInside"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/search_edit_text"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/tintColorOnSecondary"/>
        <EditText
            android:textColorHint="?attr/tintColorOnSecondary"
            android:ellipsize="end"
            android:id="@+id/search_edit_text"
            android:background="@android:color/transparent"
            android:paddingLeft="0dp"
            android:paddingTop="11dp"
            android:paddingRight="0dp"
            android:paddingBottom="13dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:textCursorDrawable="@drawable/live_search_cursor"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/movies_catalog"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.UIKit.TextView.Title4"/>
        <FrameLayout
            android:id="@+id/back_button_container"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/back_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ui_kit_ic_dropleft_24"
                android:contentDescription="@string/omnibox_back"
                app:tint="?attr/toolbarIconColor"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/movies_catalog"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="52dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_filter_list"
                android:contentDescription="@string/omnibox_settings"
                app:tint="?attr/tintColorOnSecondary"/>
        </FrameLayout>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/right_vertical_divider"
            android:background="@color/white"
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginStart="19dp"
            android:backgroundTint="?attr/tintColorOnSecondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/movies_catalog"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/reset_button_container"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/reset_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/omnibox_reset"
                app:tint="?attr/colorIcon"/>
        </FrameLayout>
        <View
            android:id="@+id/bottom_horizontal_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="?attr/horizontalDividerStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
