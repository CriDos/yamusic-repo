<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/plus_sdk_daily_quests_widget_max_height"
    android:maxHeight="@dimen/plus_sdk_daily_quests_widget_max_height"
    android:importantForAccessibility="noHideDescendants">
    <View
        android:id="@+id/plus_sdk_image_placeholder_view"
        android:layout_width="@dimen/plus_sdk_daily_quests_quest_image_size"
        android:layout_height="@dimen/plus_sdk_daily_quests_quest_image_size"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.05"
        android:layout_marginStart="16dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/plus_sdk_title_placeholder_view"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:alpha="0.05"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/plus_sdk_subtitle_placeholder_view"
        app:layout_constraintEnd_toStartOf="@+id/plus_sdk_arrow_image_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/plus_sdk_image_placeholder_view"
        app:layout_constraintTop_toTopOf="@+id/plus_sdk_image_placeholder_view"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="148dp"/>
    <View
        android:id="@+id/plus_sdk_subtitle_placeholder_view"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        android:alpha="0.05"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/plus_sdk_description_placeholder_view"
        app:layout_constraintEnd_toStartOf="@+id/plus_sdk_arrow_image_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/plus_sdk_image_placeholder_view"
        app:layout_constraintTop_toBottomOf="@+id/plus_sdk_title_placeholder_view"
        app:layout_constraintWidth_max="64dp"/>
    <View
        android:id="@+id/plus_sdk_description_placeholder_view"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:alpha="0.05"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/plus_sdk_image_placeholder_view"
        app:layout_constraintEnd_toStartOf="@+id/plus_sdk_arrow_image_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/plus_sdk_image_placeholder_view"
        app:layout_constraintTop_toBottomOf="@+id/plus_sdk_subtitle_placeholder_view"
        app:layout_constraintWidth_max="220dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/plus_sdk_arrow_image_view"
        android:layout_width="@dimen/plus_sdk_daily_quests_arrow_size"
        android:layout_height="@dimen/plus_sdk_daily_quests_arrow_size"
        android:scaleType="fitEnd"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/plus_sdk_daily_quest_action_arrow"
        app:tint="?attr/plus_sdk_daily_quests_action_arrow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
