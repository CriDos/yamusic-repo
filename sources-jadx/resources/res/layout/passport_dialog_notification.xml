<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/passport_silent_push_description">
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/passport_yandex_logo"
        app:srcCompat="?attr/passport_id_logo"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/passport_notification_first_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lineSpacingExtra="2sp"
                android:textIsSelectable="true"
                android:fontFamily="@font/ya_medium"/>
            <ImageView
                android:id="@+id/passport_notification_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/passport_ic_copy"
                android:contentDescription="@string/passport_copy_to_clipboard_description"
                android:layout_marginStart="4dp"
                app:tint="?attr/passportCopyButtonColor"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/passport_dialog_notification_otp"
            android:lineSpacingExtra="2sp"
            android:importantForAccessibility="no"
            android:fontFamily="@font/ya_regular"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/passport_notification_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/passport_roundabout_close"
        android:contentDescription="@string/passport_close_dialog_description"
        app:tint="?android:attr/textColorPrimary"/>
</LinearLayout>
