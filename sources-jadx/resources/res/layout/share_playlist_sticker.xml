<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="880px"
    android:layout_height="wrap_content"
    android:maxHeight="1400px">
    <ImageView
        android:id="@+id/cover"
        android:layout_width="330px"
        android:layout_height="330px"
        android:layout_alignParentRight="true"/>
    <View
        android:id="@+id/cove_box_divider"
        android:background="@color/bg_special_sticker"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginTop="-2px"
        android:layout_below="@+id/cover"/>
    <TextView
        android:textSize="45px"
        android:textStyle="bold"
        android:textColor="@color/text_primary_night"
        android:ellipsize="end"
        android:id="@+id/playlist_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45px"
        android:layout_marginTop="35px"
        android:layout_marginRight="45px"
        android:lines="3"
        android:layout_toLeftOf="@+id/cover"
        android:layout_alignParentLeft="true"
        android:fontFamily="@font/ya_medium"/>
    <TextView
        android:textSize="25px"
        android:textColor="@color/text_primary_night"
        android:gravity="center"
        android:id="@+id/playlist_subtitle"
        android:background="@drawable/share_subtitle_background"
        android:paddingLeft="23px"
        android:paddingRight="23px"
        android:layout_width="wrap_content"
        android:layout_height="55px"
        android:layout_marginLeft="45px"
        android:layout_marginTop="24px"
        android:layout_marginBottom="41px"
        android:text="@string/share_playlist_preview_subtitle"
        android:lines="1"
        android:layout_above="@+id/cove_box_divider"
        android:layout_alignParentLeft="true"
        android:textAllCaps="true"
        android:fontFamily="@font/ya_medium"/>
    <TextView
        android:textSize="38px"
        android:textColor="@color/text_primary_night"
        android:gravity="center"
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30px"
        android:layout_marginRight="30px"
        android:scaleType="fitStart"
        android:text="@string/service_yandex_music"
        android:layout_toLeftOf="@+id/cover"
        android:layout_toRightOf="@+id/playlist_subtitle"
        android:layout_alignBaseline="@+id/playlist_subtitle"
        android:fontFamily="@font/ya_logotype"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/track_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cove_box_divider"/>
    <View
        android:background="@drawable/share_white_rectangle_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/track_list"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
