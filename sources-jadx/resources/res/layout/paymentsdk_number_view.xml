<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/paymentsdk_number_view_cursor"
        android:background="?attr/paymentsdk_cvv_input_text_color"
        android:visibility="invisible"
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="?attr/paymentsdk_cvv_input_text_color"
        android:gravity="center"
        android:id="@+id/paymentsdk_number_view_number"
        android:visibility="invisible"
        android:layout_width="18dp"
        android:layout_height="26dp"
        android:text="1"
        app:layout_constraintStart_toEndOf="@+id/paymentsdk_number_view_cursor"/>
</androidx.constraintlayout.widget.ConstraintLayout>
