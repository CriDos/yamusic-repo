<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/presale_offer_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/pay_sdk_margin_large_plus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/PaySDK.TextAppearance.Title4"
            android:textColor="?attr/pay_sdk_primaryTextColor"
            android:id="@+id/presale_offer_period_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:layout_marginEnd="@dimen/pay_sdk_margin_small"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/presale_offer_benefit_text"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="?attr/pay_sdk_buttonPrimaryTextColor"
            android:id="@+id/presale_offer_benefit_text"
            android:paddingLeft="@dimen/pay_sdk_margin_middle_plus"
            android:paddingTop="@dimen/pay_sdk_margin_small"
            android:paddingRight="@dimen/pay_sdk_margin_middle_plus"
            android:paddingBottom="@dimen/pay_sdk_margin_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:paddingHorizontal="@dimen/pay_sdk_margin_middle_plus"
            android:paddingVertical="@dimen/pay_sdk_margin_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/PaySDK.TextAppearance.Title2"
            android:textColor="?attr/pay_sdk_primaryTextColor"
            android:id="@+id/presale_offer_price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pay_sdk_margin_middle"
            android:textIsSelectable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/presale_offer_period_text"/>
        <TextView
            android:textAppearance="@style/PaySDK.TextAppearance.Body2"
            android:textColor="?attr/pay_sdk_primaryTextColor"
            android:id="@+id/presale_offer_price_description_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pay_sdk_margin_small_plus"
            android:textIsSelectable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/presale_offer_price_text"/>
        <Button
            android:id="@+id/presale_offer_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pay_sdk_margin_giant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/presale_offer_price_description_text"
            style="@style/PaySDK.Button.Brand"/>
        <TextView
            android:textAppearance="@style/PaySDK.TextAppearance.Body2"
            android:gravity="center"
            android:id="@+id/presale_offer_additional_button_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pay_sdk_margin_large"
            android:textIsSelectable="true"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/presale_offer_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
