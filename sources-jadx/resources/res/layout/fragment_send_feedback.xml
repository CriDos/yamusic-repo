<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/edge_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <ru.yandex.music.ui.view.YaRotatingProgress
        android:id="@+id/feedback_sending_progress"
        android:layout_width="@dimen/yprogress_middle"
        android:layout_height="@dimen/yprogress_middle"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/img_status"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        android:layout_above="@+id/center"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/center"
        android:layout_width="0dp"
        android:layout_height="@dimen/unit_margin"
        android:layout_centerInParent="true"/>
    <TextView
        android:gravity="center"
        android:id="@+id/text_view_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:layout_below="@+id/center"
        android:layout_centerHorizontal="true"
        style="@style/PhonotekaTitle"/>
    <Button
        android:id="@+id/btn_ok_retry"
        android:visibility="gone"
        android:layout_width="@dimen/playback_button_min_width"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/unit_margin"
        android:text="@string/retry_sending"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
