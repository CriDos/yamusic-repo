<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/passport_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/btn_close"
        android:background="@drawable/passport_bg_overlay_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:srcCompat="@drawable/passport_ic_close"
        app:tint="@color/passport_white"/>
    <Button
        android:textColor="@color/passport_white"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/btn_anchor_top"
        android:background="@drawable/passport_bg_overlay_btn"
        android:layout_width="180dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:text="Anchor top"/>
    <Button
        android:textColor="@color/passport_white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btn_anchor_bottom"
        android:background="@drawable/passport_bg_overlay_btn"
        android:layout_width="180dp"
        android:layout_height="40dp"
        android:layout_marginBottom="24dp"
        android:text="Anchor bottom"/>
    <Button
        android:textColor="@color/passport_white"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/btn_anchor_right"
        android:background="@drawable/passport_bg_overlay_btn"
        android:layout_width="70dp"
        android:layout_height="140dp"
        android:layout_marginRight="12dp"
        android:text="Anchor\10right"
        android:layout_marginEnd="12dp"/>
    <Button
        android:textColor="@color/passport_white"
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/btn_anchor_left"
        android:background="@drawable/passport_bg_overlay_btn"
        android:layout_width="70dp"
        android:layout_height="140dp"
        android:layout_marginLeft="12dp"
        android:text="Anchor\10left"
        android:layout_marginStart="12dp"/>
    <Button
        android:textColor="@color/passport_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn_toggle_resize"
        android:background="@drawable/passport_bg_overlay_btn"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="Toggle\10resize"/>
</FrameLayout>
