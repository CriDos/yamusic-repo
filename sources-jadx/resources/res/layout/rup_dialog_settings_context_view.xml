<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rup_settings_lang_root"
    android:background="@drawable/rup_background_oval_accent_border_24"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/rup_settings_context_height">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/rup_settings_special_context_image"
        android:layout_width="140dp"
        android:layout_height="100dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="-46dp"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/rup_settings_context_name_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        style="@style/Medium_16_20"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/rup_settings_notification_dot"
        android:background="@drawable/background_wave_settings_button_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="24dp"/>
</merge>
