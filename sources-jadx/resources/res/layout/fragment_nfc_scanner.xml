<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/paymentsdk_nfc_scanner_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/paymentsdk_nfcTextLight"
            android:gravity="left"
            android:id="@+id/nfc_top_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paymentsdk_prebuilt_card_nfc_bring_card"
            android:layout_toLeftOf="@+id/nfc_icon"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/nfc_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/paymentsdk_ic_nfc_full"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:importantForAccessibility="no"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
    </RelativeLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/paymentsdk_nfcBottomTextLight"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/nfc_bottom_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/paymentsdk_prebuilt_card_nfc_enter_manually"/>
</LinearLayout>
