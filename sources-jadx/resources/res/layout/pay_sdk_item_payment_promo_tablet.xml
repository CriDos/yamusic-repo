<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/payment_promo_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    app:rippleColor="@color/pay_sdk_transparent"
    style="@style/PaySDK.Theme.Card.Rounded">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/pay_sdk_promo_card_min_height_tablet">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/pay_sdk_margin_large"
            android:paddingTop="@dimen/pay_sdk_margin_middle"
            android:paddingRight="@dimen/pay_sdk_margin_large"
            android:paddingBottom="@dimen/pay_sdk_margin_middle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/pay_sdk_margin_large"
            android:paddingVertical="@dimen/pay_sdk_margin_middle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/payment_promo_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="?attr/pay_sdk_buttonPrimaryTextColor"
                android:id="@+id/payment_promo_primary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PaySDK.TextAppearance.Body2"/>
            <TextView
                android:textColor="?attr/pay_sdk_buttonPrimaryTextColor"
                android:id="@+id/payment_promo_secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"
                style="@style/PaySDK.TextAppearance.Body2"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/payment_promo_image"
            android:layout_width="@dimen/pay_sdk_promo_image_size_tablet"
            android:layout_height="@dimen/pay_sdk_promo_image_size_tablet"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
