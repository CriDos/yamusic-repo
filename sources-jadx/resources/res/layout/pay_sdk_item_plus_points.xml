<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/plus_points_block"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/pay_sdk_margin_small"
    android:layout_marginBottom="@dimen/pay_sdk_margin_small"
    android:layout_marginVertical="@dimen/pay_sdk_margin_small">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/plus_points_top_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="@dimen/pay_sdk_margin_small_plus"/>
    <ImageView
        android:id="@+id/plus_points_icon"
        android:padding="@dimen/pay_sdk_margin_small"
        android:layout_width="36dp"
        android:layout_height="24dp"
        android:src="@drawable/pay_sdk_ic_plus_common"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/plus_points_divider_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/plus_points_top_guideline"/>
    <TextView
        android:textColor="?attr/pay_sdk_primaryTextColor"
        android:id="@+id/plus_points_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/pay_sdk_margin_large"
        android:layout_marginRight="@dimen/pay_sdk_margin_large"
        android:textIsSelectable="true"
        android:layout_marginHorizontal="@dimen/pay_sdk_margin_large"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/plus_points_divider_barrier"
        app:layout_constraintEnd_toStartOf="@+id/plus_points_switch"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/plus_points_icon"
        app:layout_constraintTop_toTopOf="@+id/plus_points_top_guideline"
        style="@style/PaySDK.TextAppearance.Body2"/>
    <com.yandex.plus.pay.ui.core.mobile.view.PlusPayResizableSwitch
        android:id="@+id/plus_points_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/plus_points_top_guideline"
        app:pay_sdk_trackWidth="@dimen/pay_sdk_switch_width"
        style="@style/PaySDK.Switch"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/plus_points_divider_barrier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="@dimen/pay_sdk_margin_small"
        app:constraint_referenced_ids="plus_points_icon, plus_points_text, plus_points_switch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/plus_points_divider"
        android:background="?attr/pay_sdk_dividerColor"
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/plus_points_text"
        app:layout_constraintTop_toBottomOf="@+id/plus_points_divider_barrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
