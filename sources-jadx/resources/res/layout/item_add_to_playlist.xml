<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ripple_juicy_cells"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <ru.yandex.music.ui.view.RoundedOutlineProviderImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/item_add_to_playlist_image"
        android:layout_width="@dimen/juicy_bottom_sheet_playlist_cover_size"
        android:layout_height="@dimen/juicy_bottom_sheet_playlist_cover_size"
        android:layout_marginStart="8dp"
        app:outline_corner_radius="@dimen/corner_4"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/item_add_to_playlist_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="54dp"
        style="@style/BottomsheetItemText"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/item_add_to_playlist_contains"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check_fill_28"
        android:contentDescription="@string/add_remove_button_added_content_description"
        android:layout_marginEnd="16dp"
        app:tint="?attr/iconSuccess"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/item_add_to_playlist_add"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_add_24"
        android:contentDescription="@string/add_remove_button_not_added_content_description"
        android:layout_marginEnd="18dp"
        app:tint="?attr/iconSecondary"/>
</FrameLayout>
