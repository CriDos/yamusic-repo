<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootChooseBankLayout"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bank_choose_back_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_bank_choose_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_bank_choose_text"
        app:srcCompat="@drawable/paymentsdk_ic_back"/>
    <TextView
        android:textAppearance="@style/PaymentsdkTextAppearance.Title"
        android:textSize="20sp"
        android:layout_gravity="start|top"
        android:id="@+id/title_bank_choose_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/paymentsdk_sbp_bank_choose_title"
        android:textDirection="locale"
        android:textAlignment="gravity"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bank_choose_back_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:id="@+id/infoCard"
        android:background="@drawable/paymentsdk_bg_info"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/paymentsdk_sbp_select_info"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bank_choose_text"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/banks_list_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/button_container_layout"
        app:layout_constraintTop_toBottomOf="@+id/infoCard"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/button_container_layout"
        android:background="?android:attr/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:shadowDy="-4"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="?android:attr/textColorSecondary"
            android:id="@+id/search_input_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:minHeight="65dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:endIconDrawable="0x7f0806a6"
            app:endIconMode="clear_text"
            app:endIconTint="?attr/paymentsdk_iconColorTint"
            app:endIconTintMode="src_in"
            app:hintTextAppearance="@style/PaymentsdkTextAppearance.Payments.Hint"
            app:startIconDrawable="0x7f0806d4"
            app:startIconTint="?attr/paymentsdk_iconColorTint"
            app:startIconTintMode="src_in">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/paymentsdk_sbp_search_hint"
                android:inputType="textFilter"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/paymentsdk_alternativePrimaryTextColor"
            android:gravity="center"
            android:id="@+id/pay_text"
            android:background="@drawable/paymentsdk_bg_enabled_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/paymentsdk_sbp_continue"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
