<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme.Dark"
    android:background="@color/bg_primary_night"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ru.yandex.music.ui.view.CropImageView
        android:id="@+id/promo_cover_blurred"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionName="shared_cover_blurred"
        app:cropAlign="top"
        app:cropType="fit_fill"/>
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/promo_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/cover_description"
        android:transitionName="shared_cover"/>
    <FrameLayout
        android:id="@+id/upload_cover_progress"
        android:background="?attr/bgFade"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/AppDesign.Dark"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/close_content_description"
        app:navigationIcon="@drawable/ic_close_mid_24">
        <Button
            android:layout_gravity="center"
            android:id="@+id/upload_cover"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playlist_upload_cover_button_text"
            style="@style/ButtonStyle.Small.White"/>
    </androidx.appcompat.widget.Toolbar>
</FrameLayout>
