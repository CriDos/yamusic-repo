<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/payment_method_block"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/pay_sdk_margin_small"
    android:layout_marginBottom="@dimen/pay_sdk_margin_small"
    android:animateLayoutChanges="true"
    android:layout_marginVertical="@dimen/pay_sdk_margin_small">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/payment_method_top_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="@dimen/pay_sdk_margin_small_plus"/>
    <ImageView
        android:id="@+id/payment_method_icon"
        android:padding="@dimen/pay_sdk_margin_small"
        android:layout_width="36dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/payment_method_additional_info_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/payment_method_top_guideline"/>
    <TextView
        android:textColor="?attr/pay_sdk_primaryTextColor"
        android:id="@+id/payment_method_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/pay_sdk_margin_large"
        android:layout_marginRight="@dimen/pay_sdk_margin_large"
        android:textIsSelectable="false"
        android:layout_marginHorizontal="@dimen/pay_sdk_margin_large"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/payment_method_selected_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/payment_method_icon"
        app:layout_constraintTop_toTopOf="@+id/payment_method_top_guideline"
        style="@style/PaySDK.TextAppearance.Body2"/>
    <TextView
        android:textColor="?attr/pay_sdk_primaryTextColor"
        android:id="@+id/payment_method_additional_info_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textIsSelectable="false"
        android:layout_marginEnd="@dimen/pay_sdk_margin_small"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/payment_method_promo_text"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/payment_method_text"
        app:layout_constraintTop_toBottomOf="@+id/payment_method_text"
        style="@style/PaySDK.TextAppearance.Caption"/>
    <TextView
        android:textColor="?attr/pay_sdk_primaryTextColor"
        android:id="@+id/payment_method_promo_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textIsSelectable="false"
        android:layout_marginStart="@dimen/pay_sdk_margin_small"
        android:layout_marginEnd="@dimen/pay_sdk_margin_large_plus"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/payment_method_additional_info_text"
        app:layout_constraintEnd_toStartOf="@+id/payment_method_selected_icon"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/payment_method_text"
        app:layout_constraintTop_toTopOf="@+id/payment_method_top_guideline"
        style="@style/PaySDK.TextAppearance.Body2.Medium"/>
    <ImageView
        android:id="@+id/payment_method_selected_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/pay_sdk_ic_check"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/payment_method_additional_info_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/payment_method_top_guideline"
        app:tint="?attr/pay_sdk_controlContentAccentColor"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/payment_card_divider_barrier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="@dimen/pay_sdk_margin_small"
        app:constraint_referenced_ids="payment_method_icon, payment_method_text, payment_method_additional_info_text,          payment_method_promo_text, payment_method_selected_icon"
        app:layout_constraintEnd_toEndOf="@+id/payment_card_divider_barrier"
        app:layout_constraintStart_toStartOf="@+id/payment_card_divider_barrier"/>
    <View
        android:id="@+id/payment_card_divider"
        android:background="?attr/pay_sdk_dividerColor"
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/payment_method_text"
        app:layout_constraintTop_toBottomOf="@+id/payment_card_divider_barrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
