<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_podcast_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:theme="@style/AppTheme.Dark"
        android:id="@+id/cover_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground">
        <ru.yandex.music.ui.view.SquaredByWidthShapeableImageView
            android:id="@+id/img_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/podcast_plus_badge_image_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_plus_bookmate_multicolor_18"/>
    </FrameLayout>
    <TextView
        android:id="@+id/txt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="2"
        android:layout_toLeftOf="@+id/explicit_mark"
        android:layout_below="@+id/cover_container"
        style="@style/PhonotekaTitle"/>
    <TextView
        android:id="@+id/txt_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/txt_title"
        style="@style/PhonotekaSubtitleAlpha"/>
    <ru.yandex.music.ui.view.IcExplicit18ImageView
        android:id="@+id/explicit_mark"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ic_warning_explicit_height"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="5dp"
        android:scaleType="fitXY"
        android:layout_alignTop="@+id/txt_title"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
