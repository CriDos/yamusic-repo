<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yandex.payment.sdk.ui.view.HeaderView
        android:id="@+id/header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:id="@+id/stateContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout">
        <include
            android:id="@+id/emptyLoadingContainer"
            android:visibility="visible"
            layout="@layout/paymentsdk_layout_sbp_empty_loading_full"/>
        <include
            android:id="@+id/chooseBankContainer"
            android:visibility="gone"
            layout="@layout/paymentsdk_layout_sbp_choose_bank_full"/>
        <include
            android:id="@+id/loadingContainer"
            android:visibility="gone"
            layout="@layout/paymentsdk_layout_sbp_loading_full"/>
        <include
            android:id="@+id/errorContainer"
            android:visibility="gone"
            layout="@layout/paymentsdk_layout_sbp_error_full"/>
    </LinearLayout>
</LinearLayout>
