<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/paymentsdk_bg_challenger_input"
    android:paddingTop="10dp"
    android:paddingBottom="8dp"
    android:fitsSystemWindows="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="18dp"
    android:paddingEnd="20dp">
    <EditText
        android:textSize="0sp"
        android:id="@+id/editCodeReal"
        android:background="@null"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:cursorVisible="false"
        android:inputType="number"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llCodeWrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/cursor0"
            android:background="#db000000"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginEnd="1dp"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="#db000000"
            android:textColorHint="#4d000000"
            android:gravity="center"
            android:id="@+id/code1"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:hint="0"
            android:maxLength="1"
            android:layout_marginEnd="2dp"/>
        <View
            android:id="@+id/cursor1"
            android:background="#db000000"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginEnd="1dp"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#db000000"
            android:textColorHint="#4d000000"
            android:gravity="center"
            android:id="@+id/code2"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:hint="0"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="#db000000"
            android:textColorHint="#4d000000"
            android:gravity="center"
            android:id="@+id/code3"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:hint=","
            android:maxLength="1"
            android:layout_marginEnd="2dp"/>
        <View
            android:id="@+id/cursor2"
            android:background="#db000000"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginEnd="1dp"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="#db000000"
            android:textColorHint="#4d000000"
            android:gravity="center"
            android:id="@+id/code4"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:hint="0"
            android:layout_marginEnd="2dp"/>
        <View
            android:id="@+id/cursor3"
            android:background="#db000000"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginEnd="1dp"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="#db000000"
            android:textColorHint="#4d000000"
            android:gravity="center"
            android:id="@+id/code5"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:hint="0"
            android:maxLength="1"
            android:layout_marginEnd="1dp"/>
        <View
            android:id="@+id/cursor4"
            android:background="#db000000"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="#db000000"
            android:textColorHint="#4d000000"
            android:gravity="center"
            android:id="@+id/code7"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:hint="0"
            android:maxLength="1"
            android:layout_marginEnd="1dp"/>
        <View
            android:id="@+id/cursor7"
            android:background="#db000000"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="#db000000"
            android:textColorHint="#4d000000"
            android:gravity="center"
            android:id="@+id/code8"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:hint="0"
            android:maxLength="1"
            android:layout_marginEnd="1dp"/>
        <View
            android:id="@+id/cursor8"
            android:background="#db000000"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="#ff4c52"
            android:textColorHint="#4d000000"
            android:gravity="center"
            android:id="@+id/code6"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:hint="₽"/>
    </LinearLayout>
    <View
        android:id="@+id/blur"
        android:background="@drawable/paymentsdk_loading_blur"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:layout_alignTop="@+id/llCodeWrapper"
        android:layout_alignBottom="@+id/llCodeWrapper"/>
</merge>
