<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/backgroundColor"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/plus_sdk_offer_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/plus_sdk_mu_1_5"
        android:maxLines="3"
        android:layout_marginStart="@dimen/plus_sdk_mu_1_5"
        android:layout_marginEnd="@dimen/plus_sdk_mu_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PlusSDK.Widget.TextView.NativeButton.OfferText"/>
    <TextView
        android:linksClickable="true"
        android:id="@+id/plus_sdk_offer_sub_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/plus_sdk_mu_0_250"
        android:maxLines="3"
        android:layout_marginEnd="@dimen/plus_sdk_mu_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/plus_sdk_offer_text"
        app:layout_constraintTop_toBottomOf="@+id/plus_sdk_offer_text"
        style="@style/PlusSDK.Widget.TextView.NativeButton.OfferSubText"/>
    <Space
        android:id="@+id/plus_offer_space"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/plus_sdk_offer_sub_text"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textAppearance="@style/PlusSDK.TextAppearance.Body2"
        android:textColor="@color/plus_sdk_white"
        android:id="@+id/plus_sdk_native_pay_button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/plus_sdk_mu_2"
        android:layout_marginBottom="@dimen/plus_sdk_mu_1_5"
        android:maxLines="2"
        android:layout_marginStart="@dimen/plus_sdk_mu_1_5"
        android:layout_marginEnd="@dimen/plus_sdk_mu_1_5"
        app:layout_constraintBottom_toTopOf="@+id/plus_sdk_offer_one_click_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/plus_offer_space"/>
    <TextView
        android:linksClickable="true"
        android:id="@+id/plus_sdk_offer_one_click_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/plus_sdk_mu_1"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/plus_sdk_native_pay_button"
        app:layout_constraintStart_toStartOf="@+id/plus_sdk_native_pay_button"
        app:layout_constraintTop_toBottomOf="@+id/plus_sdk_native_pay_button"
        style="@style/PlusSDK.Widget.TextView.NativeButton.OfferSubText"/>
    <ProgressBar
        android:id="@+id/plus_sdk_progress_bar"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminateTint="?attr/plus_sdk_indeterminateProgressBarTintColor"
        android:indeterminateTintMode="src_in"
        app:layout_constraintBottom_toBottomOf="@+id/plus_sdk_native_pay_button"
        app:layout_constraintEnd_toEndOf="@+id/plus_sdk_native_pay_button"
        app:layout_constraintStart_toStartOf="@+id/plus_sdk_native_pay_button"
        app:layout_constraintTop_toTopOf="@+id/plus_sdk_native_pay_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
