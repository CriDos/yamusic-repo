<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="880px"
    android:layout_height="1320px">
    <FrameLayout
        android:id="@+id/album_tracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/background2"
            android:layout_width="820px"
            android:layout_height="1260px"
            android:layout_marginLeft="60px"
            android:layout_marginTop="60px">
            <ImageView
                android:id="@+id/cover2"
                android:layout_width="820px"
                android:layout_height="820px"/>
            <View
                android:background="@drawable/share_white_rectangle_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/background1"
            android:layout_width="820px"
            android:layout_height="1260px"
            android:layout_marginLeft="30px"
            android:layout_marginTop="30px"
            android:layout_marginRight="30px"
            android:layout_marginBottom="30px">
            <ImageView
                android:id="@+id/cover1"
                android:layout_width="820px"
                android:layout_height="820px"/>
            <View
                android:background="@drawable/share_white_rectangle_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/background"
        android:layout_width="820px"
        android:layout_height="1260px"
        android:layout_marginRight="60px"
        android:layout_marginBottom="60px">
        <ImageView
            android:id="@+id/cover"
            android:layout_width="820px"
            android:layout_height="820px"/>
        <TextView
            android:textSize="45px"
            android:textStyle="bold"
            android:textColor="@color/text_primary_night"
            android:ellipsize="end"
            android:id="@+id/album_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40px"
            android:layout_marginTop="40px"
            android:layout_marginRight="40px"
            android:maxLines="2"
            android:layout_below="@+id/cover"
            android:lineSpacingExtra="2px"
            android:fontFamily="@font/ya_medium"/>
        <TextView
            android:textSize="45px"
            android:textColor="@color/text_primary_night"
            android:ellipsize="end"
            android:id="@+id/album_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40px"
            android:layout_marginRight="40px"
            android:maxLines="2"
            android:layout_below="@+id/album_title"
            android:lineSpacingExtra="2px"
            android:fontFamily="@font/ya_medium"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/text_primary_night"
            android:ellipsize="end"
            android:id="@+id/album_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40px"
            android:layout_marginTop="5px"
            android:layout_marginRight="40px"
            android:maxLines="1"
            android:layout_below="@+id/album_subtitle"
            android:lineSpacingExtra="13px"
            android:fontFamily="@font/ya_medium"/>
        <TextView
            android:textSize="25px"
            android:textStyle="bold"
            android:textColor="@color/text_primary_night"
            android:gravity="center"
            android:id="@+id/album_type"
            android:background="@drawable/share_subtitle_background"
            android:paddingLeft="23px"
            android:paddingRight="23px"
            android:layout_width="wrap_content"
            android:layout_height="55px"
            android:layout_marginLeft="40px"
            android:layout_marginBottom="40px"
            android:lines="1"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:textAllCaps="true"
            android:fontFamily="@font/ya_medium"/>
        <TextView
            android:textSize="46px"
            android:textColor="@color/text_primary_night"
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="40px"
            android:layout_marginBottom="40px"
            android:text="@string/service_yandex_music"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/ya_logotype"/>
        <View
            android:background="@drawable/share_white_rectangle_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</FrameLayout>
