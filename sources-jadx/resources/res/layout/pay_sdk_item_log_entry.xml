<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/pay_sdk_margin_small"
    android:layout_marginBottom="@dimen/pay_sdk_margin_small"
    android:layout_marginVertical="@dimen/pay_sdk_margin_small">
    <TextView
        android:textColor="?attr/pay_sdk_primaryTextColor"
        android:id="@+id/log_message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textIsSelectable="true"
        style="@style/PaySDK.TextAppearance.Caption"/>
</FrameLayout>
