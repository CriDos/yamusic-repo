<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/pay_sdk_primaryBlockColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/pay_sdk_margin_large"
        android:layout_marginTop="@dimen/pay_sdk_margin_xsmall"
        android:layout_marginRight="@dimen/pay_sdk_margin_large"
        android:layout_marginBottom="@dimen/pay_sdk_margin_large"
        android:layout_marginHorizontal="@dimen/pay_sdk_margin_large"
        style="@style/PaySDK.Button.Ghost"/>
</FrameLayout>
