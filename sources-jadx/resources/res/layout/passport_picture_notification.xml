<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/passport_notification_custom_title"
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/passport_choose_image"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/passport_notification_custom_subtitle"
        android:id="@+id/notification_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/passport_notification_pictures_text"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp">
        <ImageButton
            android:id="@+id/picture_1"
            android:background="@drawable/passport_picture_rounded_background"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:layout_marginEnd="4dp"/>
        <ImageButton
            android:id="@+id/picture_2"
            android:background="@drawable/passport_picture_rounded_background"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:layout_marginEnd="4dp"/>
        <ImageButton
            android:id="@+id/picture_3"
            android:background="@drawable/passport_picture_rounded_background"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:layout_marginEnd="4dp"/>
        <ImageButton
            android:id="@+id/picture_4"
            android:background="@drawable/passport_picture_rounded_background"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/passport_notification_custom_link"
            android:id="@+id/about_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/passport_about_device"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/passport_notification_custom_link"
            android:id="@+id/not_me"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/passport_not_me_button_label"/>
    </LinearLayout>
</LinearLayout>
