<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bookmate_unavailable_bottom_sheet_layout"
    android:paddingTop="46dp"
    android:paddingBottom="46dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textColor="?attr/textPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/bookmate_unavailable_bottom_sheet_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bookmate_unavailable_bottom_sheet_message"
        style="@style/Bold_HL_22_24"/>
    <com.yandex.music.design.components.button.YandexBooksGradientViewButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/yandex_books_unavailable_bottom_sheet_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"/>
</LinearLayout>
