<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="290dp">
        <FrameLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="start|top"
                android:id="@+id/brand_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:srcCompat="?attr/paymentsdk_brandIcon"/>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/exitButtonView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:srcCompat="?attr/paymentsdk_closeIcon"/>
        </FrameLayout>
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="@dimen/paymentsdk_progress_size"
            android:layout_height="@dimen/paymentsdk_progress_size"
            android:indeterminateDrawable="@drawable/paymentsdk_progress"
            android:indeterminateTint="?attr/paymentsdk_progressBarColor"
            android:indeterminateTintMode="src_in"
            app:layout_constraintBottom_toTopOf="@+id/result_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_layout"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:id="@+id/result_image"
            android:layout_width="@dimen/paymentsdk_progress_size"
            android:layout_height="@dimen/paymentsdk_progress_size"
            android:layout_marginTop="32dp"
            app:layout_constraintBottom_toTopOf="@+id/result_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progress_bar"/>
        <TextView
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/result_subtitle"
            app:layout_constraintTop_toBottomOf="@+id/result_image"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/result_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/close_button"
            app:layout_constraintTop_toBottomOf="@+id/result_text"/>
        <com.yandex.payment.sdk.ui.view.payment.PaymentButtonView
            android:id="@+id/close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
