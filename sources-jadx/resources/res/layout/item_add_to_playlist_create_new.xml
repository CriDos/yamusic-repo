<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ripple_juicy_cells"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <ru.yandex.music.ui.view.RoundedOutlineProviderImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/item_add_to_playlist_create_new_icon"
        android:background="?attr/buttonSecondary"
        android:padding="8dp"
        android:layout_width="@dimen/juicy_bottom_sheet_playlist_cover_size"
        android:layout_height="@dimen/juicy_bottom_sheet_playlist_cover_size"
        android:scaleType="center"
        android:layout_marginStart="8dp"
        app:outline_corner_radius="@dimen/corner_4"
        app:srcCompat="@drawable/ic_add_24"
        app:tint="?attr/iconSecondary"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/item_add_to_playlist_create_new_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_create_new_playlist"
        android:maxLines="1"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="8dp"
        style="@style/BottomsheetItemText"/>
</FrameLayout>
