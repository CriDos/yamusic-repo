<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/item_catalog_menu_container"
    android:background="@drawable/ripple_juicy_cells"
    android:paddingTop="@dimen/edge_margin"
    android:paddingBottom="@dimen/edge_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/juicy_item_catalog_menu_height"
    android:paddingVertical="@dimen/edge_margin">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/item_catalog_menu_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <ImageView
        android:id="@+id/item_catalog_menu_icon"
        android:layout_width="@dimen/item_catalog_menu_icon_size"
        android:layout_height="@dimen/item_catalog_menu_icon_size"
        android:layout_marginStart="@dimen/edge_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/item_catalog_menu_start_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?android:attr/textColorPrimary"
        android:ellipsize="end"
        android:id="@+id/item_catalog_menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="@dimen/edge_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_catalog_menu_notification"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/item_catalog_menu_title_start_barrier"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Medium_16_20"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/item_catalog_menu_notification"
        android:background="@color/avatar_alert_red"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:scaleType="fitStart"
        android:baselineAlignBottom="true"
        android:layout_marginStart="@dimen/juicy_margin_small"
        app:layout_constraintBaseline_creator="@+id/item_catalog_menu_title"
        app:layout_constraintBaseline_toBaselineOf="@+id/item_catalog_menu_title"
        app:layout_constraintEnd_toStartOf="@+id/item_catalog_menu_navigate_icon"
        app:layout_constraintStart_toEndOf="@+id/item_catalog_menu_title"
        app:shapeAppearance="@style/RoundedImageView50"/>
    <ImageView
        android:id="@+id/item_catalog_menu_navigate_icon"
        android:visibility="gone"
        android:layout_width="@dimen/item_catalog_menu_navigate_icon_size"
        android:layout_height="@dimen/item_catalog_menu_navigate_icon_size"
        android:src="@drawable/ic_arrow_mid_right_24"
        android:scaleType="fitEnd"
        android:layout_marginStart="@dimen/juicy_margin_small"
        android:layout_marginEnd="@dimen/edge_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/iconWithText"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/item_catalog_menu_title_start_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="item_catalog_menu_icon,item_catalog_menu_start_guideline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
