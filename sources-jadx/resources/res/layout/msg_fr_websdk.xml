<?xml version="1.0" encoding="utf-8"?>
<com.yandex.messenger.websdk.internal.view.BackHandlingFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/msg_webview_error"
        android:background="@color/msg_light_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/msg_img_sadcat_min"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/msg_light_primaryText"
            android:gravity="center"
            android:id="@+id/msg_webview_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/bad_connection_error"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/msg_light_secondaryText"
            android:layout_gravity="center"
            android:id="@+id/msg_webview_error_btn"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/try_again"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/msg_webview_progress"
        android:background="@color/msg_light_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/msg_webview_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="@color/msg_light_accent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/msg_light_primaryText"
            android:id="@+id/msg_webview_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_in_progress"/>
    </LinearLayout>
</com.yandex.messenger.websdk.internal.view.BackHandlingFrameLayout>
