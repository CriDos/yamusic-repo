<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_optimizationLevel="legacy">
    <TextView
        android:id="@+id/position_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium_2"
        android:minWidth="24dp"
        app:layout_constraintEnd_toStartOf="@+id/poster_view"
        app:layout_constraintStart_toStartOf="@+id/begin_guideline"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.UIKit.TextView.Title5"/>
    <ru.kinopoisk.uikit.legacy.widget.PosterView
        android:id="@+id/poster_view"
        android:paddingRight="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium_2"
        android:layout_marginBottom="@dimen/space_medium_2"
        android:layout_marginStart="@dimen/space_small_2"
        android:layout_marginEnd="@dimen/space_medium_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/position_text_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        app:posterHeight="@dimen/movie_view_holder_poster_height"
        app:posterWidth="@dimen/movie_view_holder_poster_width"/>
    <ImageView
        android:id="@+id/planned_to_watch_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_bookmark"
        android:layout_marginEnd="52dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorPrimary"/>
    <TextView
        android:textColor="?android:attr/textColorPrimary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium_2"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/space_medium_2"
        app:layout_constraintEnd_toStartOf="@+id/end_text_barrier"
        app:layout_constraintStart_toEndOf="@+id/poster_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"
        style="@style/Widget.UIKit.TextView.Subtitle"/>
    <TextView
        android:ellipsize="marquee"
        android:id="@+id/original_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/release_years"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Widget.UIKit.TextView.Body"/>
    <TextView
        android:id="@+id/release_years"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/end_text_barrier"
        app:layout_constraintStart_toEndOf="@+id/original_name"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Widget.UIKit.TextView.Body"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="vertical"
        android:id="@+id/bottom_text_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="release_years,original_name"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small_2"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/end_text_barrier"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/bottom_text_barrier"
        style="@style/Widget.UIKit.TextView.Caption"/>
    <ru.kinopoisk.presentation.widget.shield.PurchaseShieldView
        android:id="@+id/shield_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small_2"
        android:layout_marginBottom="@dimen/space_medium_2"
        android:layout_marginEnd="@dimen/space_medium_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/additional_info"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginEnd="0dp"/>
    <TextView
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/additional_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small_2"
        android:layout_marginBottom="@dimen/space_medium_2"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/quick_actions_button"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_default="wrap"
        style="@style/Widget.UIKit.TextView.Body"/>
    <ImageView
        android:id="@+id/quick_actions_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingLeft="@dimen/space_small_3"
        android:paddingTop="@dimen/space_medium_1"
        android:paddingRight="@dimen/space_small_3"
        android:paddingBottom="@dimen/space_medium_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_small_3"
        android:src="@drawable/ic_dots"
        android:contentDescription="@string/more"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_default="wrap"
        app:tint="?attr/colorOnSecondary"/>
    <TextView
        android:id="@+id/my_rating"
        android:paddingBottom="22dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="2dp"
        android:paddingStart="@dimen/space_small_2"
        android:paddingEnd="@dimen/space_small_2"
        app:layout_constraintEnd_toStartOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/end_text_barrier"
        app:layout_constraintTop_toTopOf="@+id/title"
        style="@style/Widget.UIKit.TextView.Title5"/>
    <ImageView
        android:id="@+id/is_in_folder_image_view"
        android:layout_width="15dp"
        android:layout_height="13dp"
        android:src="@drawable/ic_in_folder"
        android:layout_marginStart="@dimen/space_small_2"
        android:layout_marginEnd="@dimen/space_small_2"
        app:layout_constraintEnd_toStartOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/end_text_barrier"
        app:layout_constraintTop_toBottomOf="@+id/my_rating"
        app:tint="?android:attr/textColorPrimary"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/end_text_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="my_rating,is_in_folder_image_view"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/space_medium_2"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/begin_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/space_small_3"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_medium_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/horizontalDividerStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
