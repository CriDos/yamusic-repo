<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/plus_debug_panel_dialog_shadow"
        android:background="@color/home_sdk_color_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/plus_debug_panel_dialog_top_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.25"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/plus_debug_panel_dialog_bottom_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.75"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/plus_debug_panel_dialog_start_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.1"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/plus_debug_panel_dialog_end_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.9"/>
        <View
            android:id="@+id/plus_debug_panel_dialog_root_group"
            android:background="@drawable/plus_debug_panel_bg_all_corners_rounded"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="1"
            app:layout_constraintBottom_toBottomOf="@+id/plus_debug_panel_dialog_bottom_guideline"
            app:layout_constraintEnd_toEndOf="@+id/plus_debug_panel_dialog_end_guideline"
            app:layout_constraintStart_toStartOf="@+id/plus_debug_panel_dialog_start_guideline"
            app:layout_constraintTop_toTopOf="@+id/plus_debug_panel_dialog_top_guideline"/>
        <TextView
            android:textSize="@dimen/home_sdk_size_font_size_title_4"
            android:textStyle="bold"
            android:id="@+id/plus_debug_panel_dialog_title_text"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/plus_sdk_debug_panel_choose_field_to_display"
            app:layout_constraintEnd_toEndOf="@+id/plus_debug_panel_dialog_end_guideline"
            app:layout_constraintStart_toStartOf="@+id/plus_debug_panel_dialog_start_guideline"
            app:layout_constraintTop_toTopOf="@+id/plus_debug_panel_dialog_top_guideline"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/plus_debug_panel_dialog_list"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingHorizontal="32dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/plus_debug_panel_dialog_reset_text"
            app:layout_constraintEnd_toEndOf="@+id/plus_debug_panel_dialog_end_guideline"
            app:layout_constraintStart_toStartOf="@+id/plus_debug_panel_dialog_start_guideline"
            app:layout_constraintTop_toBottomOf="@+id/plus_debug_panel_dialog_title_text"/>
        <TextView
            android:textSize="@dimen/home_sdk_size_font_size_body_m"
            android:id="@+id/plus_debug_panel_dialog_reset_text"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_sdk_debug_panel_reset"
            app:layout_constraintBottom_toBottomOf="@+id/plus_debug_panel_dialog_bottom_guideline"
            app:layout_constraintStart_toStartOf="@+id/plus_debug_panel_dialog_start_guideline"
            app:layout_constraintTop_toBottomOf="@+id/plus_debug_panel_dialog_list"/>
        <TextView
            android:textSize="@dimen/home_sdk_size_font_size_body_m"
            android:id="@+id/plus_debug_panel_dialog_cancel_text"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_sdk_debug_panel_cancel"
            app:layout_constraintBottom_toBottomOf="@+id/plus_debug_panel_dialog_bottom_guideline"
            app:layout_constraintEnd_toStartOf="@+id/plus_debug_panel_dialog_ok_text"
            app:layout_constraintTop_toBottomOf="@+id/plus_debug_panel_dialog_list"/>
        <TextView
            android:textSize="@dimen/home_sdk_size_font_size_body_m"
            android:id="@+id/plus_debug_panel_dialog_ok_text"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_sdk_debug_panel_ok"
            app:layout_constraintBottom_toBottomOf="@+id/plus_debug_panel_dialog_bottom_guideline"
            app:layout_constraintEnd_toEndOf="@+id/plus_debug_panel_dialog_end_guideline"
            app:layout_constraintTop_toBottomOf="@+id/plus_debug_panel_dialog_list"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
