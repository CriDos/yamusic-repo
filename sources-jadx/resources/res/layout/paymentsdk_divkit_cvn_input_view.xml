<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/paymentsdk_cvv_fake_edittext"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:inputType="numberPassword"
            android:imeOptions="actionDone"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/paymentsdk_container_for_numbers"
            android:background="@drawable/paymentsdk_bg_challenger_input"
            android:paddingLeft="15dp"
            android:paddingTop="20dp"
            android:paddingRight="15dp"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/paymentsdk_cvv_input_background"
            android:paddingHorizontal="15dp"
            android:paddingVertical="20dp"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/paymentsdk_cvv_blur_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/paymentsdk_container_for_numbers"
            app:layout_constraintEnd_toEndOf="@+id/paymentsdk_container_for_numbers"
            app:layout_constraintStart_toStartOf="@+id/paymentsdk_container_for_numbers"
            app:layout_constraintTop_toTopOf="@+id/paymentsdk_container_for_numbers">
            <View
                android:id="@+id/paymentsdk_cvv_blur"
                android:background="@drawable/paymentsdk_divkit_cvv_loading_blur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.9"
                android:backgroundTint="?attr/paymentsdk_cvv_input_blur_color"
                app:layout_constraintWidth_percent="2"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
