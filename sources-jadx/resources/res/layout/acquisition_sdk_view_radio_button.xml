<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/acquisition_sdk_dimension_size_100"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/checkable_container"
        android:background="@drawable/acquisition_sdk_bg_radio_button"
        android:paddingLeft="@dimen/acquisition_sdk_dimension_size_200"
        android:paddingTop="@dimen/acquisition_sdk_dimension_size_175"
        android:paddingRight="@dimen/acquisition_sdk_dimension_size_200"
        android:paddingBottom="@dimen/acquisition_sdk_dimension_size_175"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/acquisition_sdk_dimension_size_200"
        android:paddingVertical="@dimen/acquisition_sdk_dimension_size_175"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline">
        <com.yandex.plus.acquisition.sdk.button.section.ui.impl.views.product.texts.ProductTextsView
            android:id="@+id/product_texts_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/acquisition_sdk_dimension_size_125"
            app:layout_constraintEnd_toStartOf="@+id/indicator_image_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/indicator_image_view"
            android:layout_width="@dimen/acquisition_sdk_radio_button_indicator_size"
            android:layout_height="@dimen/acquisition_sdk_radio_button_indicator_size"
            android:src="@drawable/acquisition_sdk_selector_radio_button_indicator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.yandex.plus.acquisition.sdk.button.section.ui.impl.views.badges.BadgesView
        android:orientation="horizontal"
        android:id="@+id/badges_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/acquisition_sdk_dimension_size_200"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
