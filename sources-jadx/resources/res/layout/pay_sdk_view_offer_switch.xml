<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offer_switch_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:strokeWidth="1dp"
    style="@style/PaySDK.Theme.Card.Rounded">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/offer_switch_layout"
        android:padding="@dimen/pay_sdk_margin_xsmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/offer_switch_selected_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="?attr/pay_sdk_secondaryBlockColor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/offer_switch_original_text"
            app:layout_constraintStart_toStartOf="@+id/offer_switch_original_text"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/PaySDK.Theme.Card.Rounded"/>
        <TextView
            android:textColor="?attr/pay_sdk_primaryTextColor"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/offer_switch_original_text"
            android:paddingLeft="@dimen/pay_sdk_margin_middle_plus"
            android:paddingTop="@dimen/pay_sdk_margin_middle"
            android:paddingRight="@dimen/pay_sdk_margin_middle_plus"
            android:paddingBottom="@dimen/pay_sdk_margin_middle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textIsSelectable="false"
            android:textAlignment="center"
            android:paddingHorizontal="@dimen/pay_sdk_margin_middle_plus"
            android:paddingVertical="@dimen/pay_sdk_margin_middle"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/offer_switch_suggested_flow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/PaySDK.TextAppearance.Caption.Medium"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/offer_switch_suggested_flow"
            android:paddingLeft="@dimen/pay_sdk_margin_middle_plus"
            android:paddingTop="@dimen/pay_sdk_margin_middle"
            android:paddingRight="@dimen/pay_sdk_margin_middle_plus"
            android:paddingBottom="@dimen/pay_sdk_margin_middle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/pay_sdk_margin_middle_plus"
            android:paddingVertical="@dimen/pay_sdk_margin_middle"
            app:constraint_referenced_ids="offer_switch_suggested_text, offer_switch_badge_card"
            app:flow_horizontalGap="@dimen/pay_sdk_margin_middle"
            app:flow_horizontalStyle="packed"
            app:flow_verticalGap="@dimen/pay_sdk_margin_small"
            app:flow_wrapMode="none"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/offer_switch_original_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="?attr/pay_sdk_primaryTextColor"
            android:ellipsize="end"
            android:id="@+id/offer_switch_suggested_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textIsSelectable="false"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintWidth_min="16dp"
            style="@style/PaySDK.TextAppearance.Caption.Medium"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/offer_switch_badge_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/pay_sdk_successColor"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            style="@style/PaySDK.Theme.Card.Rounded">
            <TextView
                android:textColor="?attr/pay_sdk_controlContentActiveColor"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/offer_switch_badge_text"
                android:paddingLeft="@dimen/pay_sdk_margin_middle"
                android:paddingTop="@dimen/pay_sdk_margin_small"
                android:paddingRight="@dimen/pay_sdk_margin_middle"
                android:paddingBottom="@dimen/pay_sdk_margin_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textIsSelectable="false"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/pay_sdk_margin_middle"
                android:paddingVertical="@dimen/pay_sdk_margin_small"
                style="@style/PaySDK.TextAppearance.Small"/>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
