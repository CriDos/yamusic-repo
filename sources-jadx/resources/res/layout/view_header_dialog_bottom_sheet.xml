<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/drag_line"
        android:background="@drawable/background_drag_line"
        android:layout_width="35dp"
        android:layout_height="@dimen/space_small_2"
        android:layout_marginTop="@dimen/space_small_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium_3"
        android:paddingStart="@dimen/bottom_sheet_dialog_side_padding_close_visible"
        android:paddingEnd="@dimen/bottom_sheet_dialog_side_padding_close_visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drag_line"
        style="@style/Widget.UIKit.TextView.Headline1.Semibold"/>
    <ru.kinopoisk.presentation.widget.CircularIconView
        android:id="@+id/close"
        android:padding="@dimen/space_medium_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/dialog_header_close"
        app:backgroundColor="?attr/fillNineColor"
        app:iconTint="?attr/fillSixColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.UIKit.CircularCloseButtonNew"/>
</merge>
