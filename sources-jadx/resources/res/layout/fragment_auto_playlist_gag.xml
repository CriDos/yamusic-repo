<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="?attr/bgPlaceholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/auto_playlist_gag_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:background="?attr/bgFade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.music.ui.view.CoverView
            android:id="@+id/auto_playlist_gag_cover"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="56dp"
            android:transitionName="shared_cover"/>
        <TextView
            android:textColor="?attr/textPrimary"
            android:id="@+id/auto_playlist_gag_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/feed_auto_playlists_gag_default_title"
            style="@style/Bold_HL_22_24"/>
        <TextView
            android:ellipsize="end"
            android:gravity="top|center_horizontal"
            android:id="@+id/auto_playlist_gag_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="328dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            style="@style/Medium_16_20"/>
        <Button
            android:textColor="?attr/textPrimary"
            android:id="@+id/auto_playlist_gag_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minWidth="154dp"
            android:text="@string/feed_auto_playlists_gag_btn_close"
            android:textAllCaps="true"
            style="@style/ButtonStyle.Borderless"/>
        <Button
            android:textSize="@dimen/text_size_mid"
            android:gravity="center"
            android:id="@+id/auto_playlist_gag_create_button"
            android:paddingLeft="48dp"
            android:paddingRight="48dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:text="@string/autoplaylist_create_playlist"
            android:textAllCaps="true"
            style="@style/ButtonStyle"/>
    </LinearLayout>
    <ImageButton
        android:layout_gravity="top|right"
        android:id="@+id/auto_playlist_gag_close"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/edge_margin"
        android:layout_width="@dimen/fab_diameter"
        android:layout_height="@dimen/fab_diameter"
        android:src="@drawable/ic_close_mid_24"
        android:contentDescription="@string/close_content_description"
        app:tint="?attr/iconPrimary"/>
</FrameLayout>
