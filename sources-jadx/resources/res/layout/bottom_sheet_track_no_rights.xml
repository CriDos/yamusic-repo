<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/container_dialog_track_no_rights"
    android:background="?android:attr/colorBackground"
    android:paddingLeft="24dp"
    android:paddingTop="46dp"
    android:paddingRight="24dp"
    android:paddingBottom="46dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/warningBottomSheetStyle">
    <TextView
        android:textColor="?attr/textPrimary"
        android:gravity="center_horizontal"
        android:id="@+id/bottom_sheet_track_no_rights_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/bottom_sheet_track_no_rights_title"
        android:maxLines="1"
        style="@style/Bold_HL_22_24"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="24dp"/>
    <TextView
        android:textColor="?attr/textPrimary"
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bottom_sheet_track_no_rights_description"
        style="@style/Medium_16_20"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="24dp"/>
    <Button
        android:textColor="@color/text_primary_day"
        android:id="@+id/close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bottom_sheet_track_no_rights_close_button"
        style="@style/Medium_16_20"/>
</LinearLayout>
