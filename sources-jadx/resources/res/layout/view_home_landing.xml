<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smart_landing_root_layout"
    android:background="?attr/bgPrimary"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <com.yandex.music.shared.wave.shader.api.component.WaveGlShaderView
        android:id="@+id/smart_landing_shader_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.music.screen.landing.api.header.ui.view.SpecialHeaderBackgroundView
        android:layout_gravity="top"
        android:id="@+id/special_header_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/smart_landing_swipe_refresh_layout"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">
        <com.yandex.music.screen.landing.ui.view.HorizontalPreferringNestedScrollView
            android:id="@+id/smart_landing_landing_wave_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:importantForAccessibility="no">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/smart_landing_wave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    android:layoutDirection="ltr"
                    android:accessibilityTraversalBefore="@+id/smart_landing_bottom_sheet_layout"/>
                <com.yandex.music.screen.landing.api.header.ui.view.HeaderContentViewFrameLayout
                    android:id="@+id/special_header_frame_layout_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"/>
            </FrameLayout>
        </com.yandex.music.screen.landing.ui.view.HorizontalPreferringNestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <FrameLayout
        android:id="@+id/smart_landing_fullscreen_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yandex.music.screen.landing.ui.view.HomeLandingBottomSheetLayout
        android:id="@+id/smart_landing_bottom_sheet_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/main_landing_content_description"
        android:importantForAccessibility="yes"
        app:behavior_hideable="false"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.yandex.music.screen.landing.ui.view.HomeLandingBottomSheetBehavior">
        <com.yandex.music.screen.landing.api.skeleton.SkeletonListView
            android:id="@+id/smart_landing_skeleton_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.yandex.music.screen.landing.ui.view.HomeLandingBottomSheetLayout>
    <com.yandex.music.screen.landing.api.header.ui.view.BottomsheetCollapsingTopBar
        android:layout_gravity="top"
        android:id="@+id/smart_landing_collapsing_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:elevation="8dp"/>
    <com.yandex.music.shared.plus.features.plaque.api.PlusPlaqueContainerView
        android:id="@+id/plaque_container"
        android:paddingTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:paddingStart="8dp"
        android:elevation="9dp"
        android:accessibilityTraversalBefore="@+id/special_header_frame_layout_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
