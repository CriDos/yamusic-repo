<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rup_settings_scroll_view"
    android:background="?attr/bgPrimary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rup_settings_constraint_view"
        android:paddingBottom="@dimen/unit_and_half_margin"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:animateLayoutChanges="false">
        <TextView
            android:textColor="?attr/textPrimary"
            android:id="@+id/rup_settings_title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rup_settings_title"
            android:layout_marginStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:layout_marginEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Bold_HL_22_24"/>
        <TextView
            android:textColor="?attr/textSecondary"
            android:id="@+id/rup_settings_context_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="@dimen/unit_and_half_margin"
            android:text="@string/rup_settings_contexts_title"
            android:layout_marginStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:layout_marginEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            android:accessibilityHeading="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_title_text_view"
            style="@style/Medium_16_20"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rup_settings_context_recycler"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rup_settings_context_height"
            android:layout_marginTop="@dimen/unit_and_half_margin"
            android:overScrollMode="never"
            android:paddingStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:paddingEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_context_text_view"/>
        <TextView
            android:textColor="?attr/textSecondary"
            android:id="@+id/rup_settings_diversity_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:layout_marginEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            android:accessibilityHeading="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_context_recycler"
            style="@style/Medium_16_20"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/rup_settings_diversity_flow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rup_settings_diversity_height"
            android:layout_marginTop="@dimen/unit_and_half_margin"
            android:layout_marginStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:layout_marginEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_diversity_text_view">
            <com.yandex.music.myvibe.settings.ui.view.LandingWaveSettingsDiversityView
                android:id="@+id/rup_settings_diversity_1"
                android:layout_width="0dp"
                android:layout_height="@dimen/rup_settings_diversity_height"
                android:layout_weight="32"/>
            <Space
                android:layout_width="4dp"
                android:layout_height="match_parent"/>
            <com.yandex.music.myvibe.settings.ui.view.LandingWaveSettingsDiversityView
                android:id="@+id/rup_settings_diversity_2"
                android:layout_width="0dp"
                android:layout_height="@dimen/rup_settings_diversity_height"
                android:layout_weight="36"/>
            <Space
                android:layout_width="4dp"
                android:layout_height="match_parent"/>
            <com.yandex.music.myvibe.settings.ui.view.LandingWaveSettingsDiversityView
                android:id="@+id/rup_settings_diversity_3"
                android:layout_width="0dp"
                android:layout_height="@dimen/rup_settings_diversity_height"
                android:layout_weight="32"/>
        </LinearLayout>
        <TextView
            android:textColor="?attr/textSecondary"
            android:id="@+id/rup_settings_mood_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:layout_marginEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            android:accessibilityHeading="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_diversity_flow"
            style="@style/Medium_16_20"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/rup_settings_mood_flow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rup_settings_mood_height"
            android:layout_marginTop="@dimen/unit_and_half_margin"
            android:layout_marginStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:layout_marginEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_mood_text_view">
            <com.yandex.music.myvibe.settings.ui.view.LandingWaveSettingMoodView
                android:id="@+id/rup_settings_mood_1"
                android:layout_width="0dp"
                android:layout_height="@dimen/rup_settings_mood_height"
                android:layout_weight="1"/>
            <Space
                android:layout_width="4dp"
                android:layout_height="match_parent"/>
            <com.yandex.music.myvibe.settings.ui.view.LandingWaveSettingMoodView
                android:id="@+id/rup_settings_mood_2"
                android:layout_width="0dp"
                android:layout_height="@dimen/rup_settings_mood_height"
                android:layout_weight="1"/>
            <Space
                android:layout_width="4dp"
                android:layout_height="match_parent"/>
            <com.yandex.music.myvibe.settings.ui.view.LandingWaveSettingMoodView
                android:id="@+id/rup_settings_mood_3"
                android:layout_width="0dp"
                android:layout_height="@dimen/rup_settings_mood_height"
                android:layout_weight="1"/>
            <Space
                android:layout_width="4dp"
                android:layout_height="match_parent"/>
            <com.yandex.music.myvibe.settings.ui.view.LandingWaveSettingMoodView
                android:id="@+id/rup_settings_mood_4"
                android:layout_width="0dp"
                android:layout_height="@dimen/rup_settings_mood_height"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textColor="?attr/textSecondary"
            android:id="@+id/rup_settings_lang_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="@dimen/unit_and_half_margin"
            android:layout_marginStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:layout_marginEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            android:accessibilityHeading="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_mood_flow"
            style="@style/Medium_16_20"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rup_settings_lang_recycler"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rup_settings_lang_height"
            android:layout_marginTop="@dimen/unit_and_half_margin"
            android:overScrollMode="never"
            android:paddingStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:paddingEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_lang_text_view"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/rup_settings_clear_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="@string/rup_settings_button_reset"
            android:layout_marginStart="@dimen/juicy_bottom_sheet_list_side_padding"
            android:layout_marginEnd="@dimen/juicy_bottom_sheet_list_side_padding"
            app:layout_constraintTop_toBottomOf="@+id/rup_settings_lang_recycler"
            style="@style/ButtonStyle.Borderless"/>
        <com.yandex.music.myvibe.settings.ui.view.YaRotatingProgress
            android:id="@+id/rup_settings_progress_view"
            android:visibility="invisible"
            android:layout_width="@dimen/yprogress_middle"
            android:layout_height="@dimen/yprogress_middle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/view_no_result"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
