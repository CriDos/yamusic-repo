<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/qr_result_popup"
        android:background="@drawable/passport_qr_result_background"
        android:paddingLeft="16sp"
        android:paddingRight="16sp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textColor="#000"
            android:gravity="center_vertical"
            android:id="@+id/qr_result_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="20dp"
            android:text="@string/passport_enter_by_qr"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:fontFamily="@font/ya_medium"
            android:layout_marginStart="32dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/qr_result_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="3dp"
            android:layout_alignTop="@+id/qr_result_title"
            android:layout_alignBottom="@+id/qr_result_title"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="3dp"
            android:layout_alignParentStart="true"
            app:srcCompat="@drawable/passport_qr_icon"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:id="@+id/qr_primary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:maxLines="11"
            android:layout_below="@+id/qr_result_title"
            android:lineSpacingExtra="2sp"
            android:fontFamily="@font/ya_medium"/>
        <View
            android:id="@+id/center"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="16sp"
            android:id="@+id/button_accept"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="4dp"
            android:text="@string/passport_login"
            android:layout_toRightOf="@+id/center"
            android:layout_below="@+id/qr_primary_text"
            android:layout_alignParentRight="true"
            android:lineSpacingExtra="4sp"
            android:fontFamily="@font/ya_regular"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/center"
            android:layout_alignParentEnd="true"
            style="@style/Passport.Widget.Button.Primary"/>
        <Button
            android:textSize="16sp"
            android:id="@+id/button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginRight="4dp"
            android:text="@string/passport_reg_cancel"
            android:layout_toLeftOf="@+id/center"
            android:layout_below="@+id/qr_primary_text"
            android:layout_alignParentLeft="true"
            android:lineSpacingExtra="4sp"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@+id/center"
            android:layout_alignParentStart="true"
            style="@style/Passport.Widget.Button.Gray"/>
    </RelativeLayout>
</FrameLayout>
