<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorBackgroundFloating"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Passport.Widget.Redesign.ScrollView">
            <com.yandex.passport.internal.widget.BoundedFrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:passport_maxWidth="@dimen/passport_screen_max_width">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingTop="@dimen/passport_authsdk_top_margin"
                    android:paddingBottom="84dp"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/Passport.Widget.Redesign.ScrollableContent">
                    <FrameLayout
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/image_app_icon"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginRight="62dp"
                            android:contentDescription="@null"
                            app:civ_border_color="#7fd4d8e0"
                            app:civ_border_width="1dp"/>
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/image_avatar"
                            android:background="?attr/passportCircleBackground"
                            android:padding="6dp"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_marginLeft="@dimen/passport_authsdk_avatar_margin_left"
                            android:contentDescription="@null"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="bottom|right"
                            android:background="?attr/passportCircleBackground"
                            android:padding="4dp"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginRight="2dp"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@null"
                            app:srcCompat="?attr/passportIcLogoYa"/>
                    </FrameLayout>
                    <TextView
                        android:textAppearance="@style/Passport.TextAppearance.Redesign.Message"
                        android:layout_gravity="center"
                        android:id="@+id/text_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/passport_auth_sdk_message"/>
                    <Button
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/button_other_account"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/passport_sdk_other_user_button"
                        style="@style/Passport.Widget.Redesign.Button.Secondary"/>
                    <TextView
                        android:textAppearance="@style/Passport.TextAppearance.Redesign.Message"
                        android:textSize="14sp"
                        android:id="@+id/text_app_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="56dp"
                        android:text="@string/passport_sdk_ask_access"
                        android:lineSpacingMultiplier="1.29"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_permissions"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.yandex.passport.internal.widget.BoundedFrameLayout>
        </androidx.core.widget.NestedScrollView>
        <com.yandex.passport.internal.widget.BoundedFrameLayout
            android:layout_gravity="bottom"
            android:background="?attr/colorBackgroundFloating"
            android:paddingLeft="24dp"
            android:paddingTop="20dp"
            android:paddingRight="24dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passport_maxWidth="@dimen/passport_screen_max_width">
            <Button
                android:ellipsize="end"
                android:id="@+id/button_accept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/passport_sdk_ask_access_allow_button"
                android:maxLines="1"
                android:elevation="4dp"
                style="@style/Passport.Widget.Redesign.Button.Primary"/>
        </com.yandex.passport.internal.widget.BoundedFrameLayout>
        <ImageView
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginBottom="84dp"
            android:src="@drawable/passport_auth_sdk_bottom_shaddow"
            android:contentDescription="@null"/>
    </FrameLayout>
    <com.yandex.passport.internal.widget.BoundedFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:passport_maxWidth="@dimen/passport_screen_max_width">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_error"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textAppearance="@style/Passport.TextAppearance.Redesign.Message"
                android:gravity="center"
                android:id="@+id/text_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/passport_margin_16"
                android:text="@string/passport_sdk_unknown_error"/>
            <Button
                android:id="@+id/button_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/passport_reg_try_again"
                android:elevation="4dp"
                style="@style/Passport.Widget.Redesign.Button.Primary"/>
        </LinearLayout>
    </com.yandex.passport.internal.widget.BoundedFrameLayout>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_decline"
        android:background="?attr/passportBackButtonBg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:scaleType="center"
        android:layout_marginStart="20dp"
        android:elevation="6dp"
        app:elevation="6dp"
        app:srcCompat="?attr/passportBackButtonIcon"/>
    <FrameLayout
        android:id="@+id/progress"
        android:background="?attr/passportProgressBackgroundColor"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</FrameLayout>
