<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/confirmExitLayout"
    android:background="?attr/paymentsdk_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/brandIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:srcCompat="?attr/paymentsdk_brandIcon"/>
        <ImageView
            android:layout_gravity="top|center_horizontal"
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            app:srcCompat="@drawable/paymentsdk_handle"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iconImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:src="?attr/paymentsdk_warning_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center"
        android:id="@+id/titleConfirmExitTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/ys_text_regular"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconImageView"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/exitButtonsContainer"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleConfirmExitTextView">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:id="@+id/confirmButton"
            android:background="@drawable/paymentsdk_bg_disabled_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/paymentsdk_confirm_exit_accept"
            android:layout_weight="1"
            android:fontFamily="@font/ys_text_regular"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/paymentsdk_alternativePrimaryTextColor"
            android:gravity="center"
            android:id="@+id/hideButton"
            android:background="@drawable/paymentsdk_bg_enabled_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/paymentsdk_confirm_exit_decline"
            android:layout_weight="1"
            android:fontFamily="@font/ys_text_regular"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
