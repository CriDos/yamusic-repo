<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_secondary"
    android:layout_width="match_parent"
    android:layout_height="201dp">
    <TextView
        android:id="@+id/award_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium_3"
        app:layout_constraintBottom_toTopOf="@+id/award_image_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.UIKit.TextView.Body"/>
    <ImageView
        android:id="@+id/award_image_view"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_medium_2"
        android:layout_marginBottom="48dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/award_text_view"/>
    <TextView
        android:gravity="center"
        android:id="@+id/awards_count_text_view"
        android:padding="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="25dp"
        android:minHeight="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/award_image_view"
        app:layout_constraintEnd_toEndOf="@+id/award_image_view"
        app:layout_constraintStart_toEndOf="@+id/award_image_view"
        style="@style/Widget.UIKit.TextView.NoteCaps"/>
</androidx.constraintlayout.widget.ConstraintLayout>
