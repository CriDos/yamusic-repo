<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="vertical">
    <TextView
        android:textAppearance="@style/PaymentSdkPrebuiltTextAppearance.Hint"
        android:id="@+id/paymentsdk_prebuilt_pan_input_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/paymentsdk_prebuilt_card_number_input_title"
        android:importantForAccessibility="no"/>
    <EditText
        android:textAppearance="@style/PaymentSdkPrebuiltTextAppearance.TextInput"
        android:textColor="?attr/paymentsdk_prebuilt_cardNumberTextColor"
        android:textColorHint="?attr/paymentsdk_prebuilt_cardNumberPlaceholderColor"
        android:id="@+id/paymentsdk_prebuilt_pan_input_text"
        android:background="@android:color/transparent"
        android:paddingTop="@dimen/paymentsdk_prebuilt_card_input_field_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/paymentsdk_prebuilt_card_number_hint"
        android:drawablePadding="4dp"
        android:inputType="number"
        android:imeOptions="flagNoExtractUi|actionNext"
        android:textCursorDrawable="@drawable/paymentsdk_text_cursor"
        android:autofillHints=""/>
</merge>
