<?xml version="1.0" encoding="utf-8"?>
<com.yandex.passport.internal.widget.BoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:passport_maxWidth="@dimen/passport_screen_max_width">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/passportBgBottomSheet"
        android:paddingTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28dp"
            android:layout_marginRight="28dp"
            android:layout_marginBottom="12dp"
            android:text="@string/passport_open_with"
            style="@style/Passport.Widget.TextView.Message.Secondary"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"/>
    </LinearLayout>
</com.yandex.passport.internal.widget.BoundedFrameLayout>
