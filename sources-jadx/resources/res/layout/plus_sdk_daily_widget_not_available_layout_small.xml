<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.Material3.DynamicColors.DayNight"
    android:id="@+id/plus_sdk_daily_widget_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/plus_sdk_daily_widget_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:layout_centerInParent="true"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="@dimen/plus_sdk_daily_widget_text_size_small"
        android:textColor="@color/plus_sdk_daily_widget_text_color"
        android:id="@+id/plus_sdk_daily_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/plus_sdk_daily_widget_default_margin_small"
        android:layout_marginRight="@dimen/plus_sdk_daily_widget_default_margin_small"
        android:layout_marginBottom="@dimen/plus_sdk_daily_widget_default_margin_small"
        android:layout_alignBottom="@+id/plus_sdk_daily_widget_background"
        android:textIsSelectable="false"
        android:importantForAccessibility="no"
        android:fontFamily="sans-serif-medium"
        android:layout_alignStart="@+id/plus_sdk_daily_widget_background"
        android:layout_marginHorizontal="@dimen/plus_sdk_daily_widget_default_margin_small"
        app:lineHeight="@dimen/plus_sdk_daily_widget_text_line_height_small"/>
    <ImageView
        android:id="@+id/plus_sdk_daily_widget_music_icon"
        android:layout_width="@dimen/plus_sdk_daily_widget_music_icon_size_small"
        android:layout_height="@dimen/plus_sdk_daily_widget_music_icon_size_small"
        android:layout_marginTop="@dimen/plus_sdk_daily_widget_default_margin_small"
        android:src="@drawable/plus_sdk_daily_widget_music_icon"
        android:tint="@color/plus_sdk_daily_widget_music_icon"
        android:layout_alignTop="@+id/plus_sdk_daily_widget_background"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/plus_sdk_daily_widget_default_margin_small"
        android:layout_alignEnd="@+id/plus_sdk_daily_widget_background"/>
</RelativeLayout>
