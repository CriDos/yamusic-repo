<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110px">
    <View
        android:id="@+id/center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="40px"
        android:textStyle="bold"
        android:textColor="@color/text_primary_night"
        android:gravity="center"
        android:id="@+id/track_num"
        android:layout_width="110px"
        android:layout_height="110px"
        android:fontFamily="@font/ya_medium"/>
    <View
        android:id="@+id/track_num_divider"
        android:background="@color/bg_special_sticker"
        android:layout_width="1px"
        android:layout_height="match_parent"
        android:layout_marginLeft="-1px"
        android:layout_toRightOf="@+id/track_num"/>
    <TextView
        android:textSize="32px"
        android:textStyle="bold"
        android:textColor="@color/text_primary_night"
        android:gravity="bottom|left"
        android:id="@+id/track_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="35px"
        android:maxLines="1"
        android:layout_toRightOf="@+id/track_num_divider"
        android:layout_above="@+id/center"
        android:layout_alignParentTop="true"
        android:fontFamily="@font/ya_medium"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/text_primary_night"
        android:gravity="top|left"
        android:id="@+id/track_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="35px"
        android:layout_toRightOf="@+id/track_num_divider"
        android:layout_below="@+id/center"
        android:layout_alignParentBottom="true"
        app:fontFamily="@font/ys_text_medium"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="@color/bg_special_sticker"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
