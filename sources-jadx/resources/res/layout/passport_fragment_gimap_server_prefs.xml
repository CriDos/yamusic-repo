<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="@dimen/passport_one_column_width"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="#80000000"
            android:id="@+id/gimap_server_prefs_step_text"
            android:paddingLeft="@dimen/passport_text_view_alignment_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_big"
            android:layout_marginTop="@dimen/passport_margin_big"
            android:layout_marginRight="@dimen/passport_margin_big"
            android:text="@string/passport_gimap_server_prefs_imap_step_text"
            android:paddingStart="@dimen/passport_text_view_alignment_padding"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/gimap_server_prefs_title"
            android:paddingLeft="@dimen/passport_text_view_alignment_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_big"
            android:layout_marginTop="@dimen/passport_margin_small"
            android:layout_marginRight="@dimen/passport_margin_big"
            android:text="@string/passport_gimap_server_prefs_imap_title"
            android:paddingStart="@dimen/passport_text_view_alignment_padding"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/gimap_form_server_host_port"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_big"
            android:layout_marginTop="@dimen/passport_margin_16"
            android:layout_marginRight="@dimen/passport_margin_big">
            <EditText
                android:id="@+id/gimap_edit_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/passport_gimap_server_prefs_imap_host_hint"
                android:maxLines="1"
                android:layout_weight="3"
                android:inputType="textUri"
                style="@style/Passport.Widget.EditText"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/gimap_input_port_container"
                android:background="?attr/editTextBackground"
                android:addStatesFromChildren="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#80000000"
                    android:id="@+id/gimap_input_port_title"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/passport_gimap_server_prefs_port_cap"/>
                <EditText
                    android:id="@+id/gimap_input_port"
                    android:background="@null"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"
                    android:inputType="number"
                    android:layout_marginStart="10dp"
                    style="@style/Passport.Widget.EditText"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/gimap_checkbox_ssl_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_big"
            android:layout_marginTop="@dimen/passport_margin_16"
            android:layout_marginRight="@dimen/passport_margin_big">
            <TextView
                android:paddingLeft="@dimen/passport_text_view_alignment_padding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/passport_gimap_server_prefs_ssl_cap"
                android:layout_weight="1"
                android:paddingStart="@dimen/passport_text_view_alignment_padding"/>
            <Switch
                android:id="@+id/gimap_checkbox_ssl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:id="@+id/error_title"
            android:background="@color/passport_rambler_notice_background_light"
            android:paddingLeft="@dimen/passport_margin_28"
            android:paddingTop="12dp"
            android:paddingRight="@dimen/passport_margin_28"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/passport_margin_large"
            android:text="@string/passport_login_rambler_notice_title"
            android:freezesText="true"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/error_text"
            android:background="@color/passport_rambler_notice_background_light"
            android:paddingLeft="@dimen/passport_margin_28"
            android:paddingTop="12dp"
            android:paddingRight="@dimen/passport_margin_28"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/passport_gimap_server_prefs_err_common_text"
            android:freezesText="true"/>
        <com.yandex.passport.internal.widget.InputFieldView
            android:id="@+id/gimap_input_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_big"
            android:layout_marginTop="@dimen/passport_margin_16"
            android:layout_marginRight="@dimen/passport_margin_big">
            <EditText
                android:id="@+id/gimap_edit_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/Passport.Widget.EditText.Login"/>
        </com.yandex.passport.internal.widget.InputFieldView>
        <com.yandex.passport.internal.widget.InputFieldView
            android:id="@+id/gimap_input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_big"
            android:layout_marginRight="@dimen/passport_margin_big">
            <EditText
                android:id="@+id/gimap_edit_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/Passport.Widget.EditText.Password"/>
            <com.google.android.material.internal.CheckableImageButton
                android:id="@+id/gimap_button_password_masking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/passport_show_password_description"
                app:srcCompat="@drawable/passport_domik_show_password"/>
        </com.yandex.passport.internal.widget.InputFieldView>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:id="@+id/gimap_email_title"
            android:paddingTop="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_28"
            android:layout_marginRight="@dimen/passport_margin_28"
            android:text="@string/passport_gimap_server_prefs_email_hint"/>
        <com.yandex.passport.internal.widget.InputFieldView
            android:id="@+id/input_email"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_big"
            android:layout_marginRight="@dimen/passport_margin_big">
            <EditText
                android:id="@+id/input_edit_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/passport_gimap_server_prefs_email_hint"
                android:maxLines="1"
                android:inputType="textNoSuggestions"
                style="@style/Passport.Widget.EditText"/>
        </com.yandex.passport.internal.widget.InputFieldView>
        <Button
            android:id="@+id/button_sign_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/passport_margin_big"
            android:layout_marginTop="@dimen/passport_margin_medium"
            android:layout_marginRight="@dimen/passport_margin_big"
            android:text="@string/passport_reg_next"
            android:hint="@string/passport_reg_next"
            android:textAllCaps="false"
            style="@style/Passport.Widget.Button.Mailish"/>
    </LinearLayout>
</ScrollView>
