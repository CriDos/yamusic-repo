<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/pay_sdk_margin_large"
    android:paddingBottom="@dimen/pay_sdk_margin_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/pay_sdk_margin_large">
    <TextView
        android:textColor="?attr/pay_sdk_primaryTextColor"
        android:id="@+id/payment_methods_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textIsSelectable="true"
        style="@style/PaySDK.TextAppearance.Title5"/>
    <com.yandex.plus.pay.ui.common.api.ui.view.ProgressView
        android:layout_gravity="center"
        android:id="@+id/payment_methods_progress_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/pay_sdk_margin_large"
        android:layout_marginTop="@dimen/pay_sdk_margin_middle"
        android:layout_marginRight="@dimen/pay_sdk_margin_large"
        android:layout_marginBottom="@dimen/pay_sdk_margin_middle"
        android:layout_marginHorizontal="@dimen/pay_sdk_margin_large"
        android:layout_marginVertical="@dimen/pay_sdk_margin_middle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/payment_methods_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pay_sdk_margin_middle"
        android:layout_marginBottom="@dimen/pay_sdk_margin_middle"
        android:layout_marginVertical="@dimen/pay_sdk_margin_middle"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/payment_promos_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pay_sdk_margin_middle"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
