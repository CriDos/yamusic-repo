<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rup_settings_mood_root"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/rup_settings_mood_height">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/rup_settings_mood_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:shapeAppearanceOverlay="@style/RoundedImageView50"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/rup_settings_mood_name_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/Medium_14_16"/>
</merge>
