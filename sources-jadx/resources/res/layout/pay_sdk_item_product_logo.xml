<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_logo_card"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    app:cardElevation="0dp"
    app:contentPadding="4dp"
    app:shapeAppearance="@style/PaySDK.Shape.Circle"
    app:strokeColor="?attr/pay_sdk_primaryPageColor"
    app:strokeWidth="4dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/product_logo_image"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        app:shapeAppearance="@style/PaySDK.Shape.Circle"/>
</com.google.android.material.card.MaterialCardView>
