<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:id="@+id/sync_dialog_root"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ru.yandex.music.ui.view.MaxSizeLinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/edge_margin"
            android:paddingTop="@dimen/edge_margin"
            android:paddingRight="@dimen/edge_margin"
            android:paddingBottom="@dimen/edge_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:maxWidth="320dp">
            <androidx.compose.ui.platform.ComposeView
                android:layout_gravity="center_horizontal"
                android:id="@+id/sync_dialog_avatar_icon_view"
                android:padding="1.5dp"
                android:layout_width="118dp"
                android:layout_height="118dp"/>
            <TextView
                android:textColor="?attr/textPrimary"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/login_sync_title"
                style="@style/Bold_HL_22_24"/>
            <TextView
                android:textColor="?attr/textPrimary"
                android:gravity="center"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_sync_subtitle"
                style="@style/Medium_16_20"/>
        </ru.yandex.music.ui.view.MaxSizeLinearLayout>
        <SeekBar
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/progress"
            android:layout_width="240dp"
            android:layout_marginBottom="@dimen/double_edge_margin"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:thumb="@android:color/transparent"
            style="@style/SeekBar"/>
    </FrameLayout>
</ScrollView>
