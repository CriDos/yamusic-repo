<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?android:attr/colorBackground"
    android:scrollbars="none"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    style="?attr/warningBottomSheetStyle">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="46dp"
        android:paddingRight="24dp"
        android:paddingBottom="46dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/textPrimary"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/bottom_sheet_track_explicit_title"
            style="@style/Bold_HL_22_24"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="24dp"/>
        <TextView
            android:textColor="?attr/textPrimary"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bottom_sheet_clip_explicit_description"
            style="@style/Medium_16_20"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="24dp"/>
        <Button
            android:textColor="@color/text_primary_day"
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bottom_sheet_track_explicit_settings_button"
            style="@style/Medium_16_20"/>
    </LinearLayout>
</ScrollView>
